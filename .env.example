# Local (`npm run db:start` then `npx supabase status`) or hosted project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MusicBrainz requires a descriptive User-Agent with contact info.
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_USER_AGENT=shelf/0.1.0 (you@example.com)

# Optional. Free key: https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=
